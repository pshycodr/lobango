{
  "$schema": "https://v2-10-8.turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build:types": {
      "dependsOn": ["^build:types"],
      "inputs": ["src/**/*.ts", "!src/**/*.test.ts"],
      "outputs": ["dist/types/**"]
    },
    "build": {
      "dependsOn": ["^build", "^build:types"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".wrangler/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types", "^build:types"]
    },
    "dev": {
      "dependsOn": ["^build:types"],
      "cache": false,
      "persistent": true,
      "env": ["*"]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
