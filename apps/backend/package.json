{
  "name": "@lobango/backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "build": "rm -rf dist && bun build src/index.ts --bundle --platform=node --outfile=dist/index.js --minify",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist/types",
    "start": "wrangler dev",
    "lint": "eslint .",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "check-types": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply lobangodb --local",
    "db:migrate:deploy": "wrangler d1 migrations apply lobangodb --remote"
  },
  "exports": {
    "./rpc/client": {
      "types": "./dist/types/src/orpc/routers/client.d.ts"
    },
    "./rpc/admin": {
      "types": "./dist/types/src/orpc/routers/admin.d.ts"
    },
    "./rpc/payment": {
      "types": "./dist/types/src/orpc/routers/payment.d.ts"
    }
  },
  "dependencies": {
    "@getbrevo/brevo": "^3.0.4",
    "@orpc/openapi": "^1.14.15",
    "@orpc/server": "^1.14.14",
    "@orpc/zod": "^1.14.15",
    "@yankeguo/hono-cookie-session": "github:yankeguo/hono-cookie-session",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.12.30",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^6.0.0",
    "plugins": "link:@orpc/openapi/plugins",
    "razorpay": "^2.9.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.2",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@eslint/js": "9.39.5",
    "@lobango/contracts": "workspace:",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "tsx": "^4.23.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.64.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  }
}
